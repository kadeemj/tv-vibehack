<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Wallpaper from the user's reference: moonlit teal landscape, drawn in code (sharp at any resolution). -->
    <com.gathin.tvhome.LandscapeView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Ambient glow in the colour of the focused dock app (grid mode only). -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code (grid mode only). -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:alpha="0"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 300"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <!-- Clock, top right, like the reference photo. -->
    <TextClock
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="60dp"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="#FFFFFFFF"
        android:textSize="40sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 300"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false" />

    <!-- The photo-style app list. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="158dp"
        android:paddingStart="52dp"
        android:paddingEnd="52dp"
        android:paddingBottom="170dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:descendantFocusability="afterDescendants" />

    <!-- The old tvOS grid, hidden until "All apps" is pressed. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="158dp"
        android:paddingTop="10dp"
        android:paddingBottom="40dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:descendantFocusability="afterDescendants"
        android:visibility="gone" />

    <!-- Bottom-right pills, like the reference photo. -->
    <LinearLayout
        android:id="@+id/bottomPills"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnAllApps"
            style="@style/TopButton"
            android:layout_marginStart="0dp"
            android:text="@string/all_apps"
            android:drawableStart="@drawable/ic_grid"
            android:nextFocusDown="@+id/list" />

        <TextView
            android:id="@+id/btnSettings"
            style="@style/TopButton"
            android:text="@string/settings"
            android:drawableStart="@drawable/ic_settings"
            android:nextFocusDown="@+id/list" />
    </LinearLayout>

    <!-- The single floating glass highlight that springs between grid tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
